{
	"compilerOptions": {
		"outDir": "./dist",
		"module": "ES6",
		"target": "ES5",
		"lib": ["dom", "es2015"],
		"jsx": "react",
		"declaration": true,
		"sourceMap": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}