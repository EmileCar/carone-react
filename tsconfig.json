{
	"compilerOptions": {
		"outDir": "./dist",
		"declaration": true,
		"declarationDir": "./dist/types",
		"esModuleInterop": true,
		"jsx": "react",
		"module": "ESNext",
		"moduleResolution": "node",
		"skipLibCheck": true,
		"strict": true,
		"target": "es5",
		"lib": ["dom", "es2017"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}